{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "types": ["vitest/globals", "happy-dom"]
    },
    "include": ["resources/js/**/*.ts", "tests/js/**/*.ts"],
    "exclude": ["node_modules"]
}
